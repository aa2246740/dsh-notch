{
  "name": "dsh-notch",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "src/dsh-notch.ts",
  "description": "Native macOS notch for live DSH sessions, approvals, and model questions.",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:motion": "sh macos/Tests/motion.sh",
    "test:geometry": "sh macos/Tests/geometry.sh",
    "build:macos": "swift build --package-path macos -c release",
    "test:outcome": "sh macos/Tests/outcome.sh",
    "test:idle": "sh macos/Tests/idle.sh",
    "build:demo": "sh tools/recording/build.sh",
    "test:scrollbar": "sh macos/Tests/scrollbar.sh",
    "test:expanded-height": "sh macos/Tests/expanded-height.sh"
  },
  "devDependencies": {
    "tsx": "4.22.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-user-questions": ">=0.1.7-rc.1 <0.1.8"
  },
