{
  "name": "dsh-notch-focus",
  "version": "0.1.2",
  "description": "Bidirectional session navigation and unread synchronization for DSH Desktop and Web 0.2.0-rc.2.",
  "type": "module",
  "main": "lib/dsh-notch-focus.js",
  "types": "lib/types/dsh-notch-focus.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-notch-focus.d.ts",
      "default": "./lib/dsh-notch-focus.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2"
  }
}
